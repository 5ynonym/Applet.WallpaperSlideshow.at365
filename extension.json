{
    "apiVersion":  1,
    "id":  "at365.wallpaper-slideshow",
    "name":  "Applet.WallpaperSlideshow.at365",
    "version":  "0.1.0",
    "minimumHostVersion":  "0.5.0",
    "startupDelaySeconds":  30,
    "updateRepository":  "5ynonym/Applet.WallpaperSlideshow.at365",
    "runtime":  "native",
    "entry":  "Applet.WallpaperSlideshow.at365.exe",
    "description":  "モニターごとの複数フォルダーから壁紙を再生。タイル・フォルダー監視・AppDock内の履歴に対応します。",
    "capabilities":  [
                         "ui",
                         "settings"
                     ],
    "settings":  [
                     {
                         "title":  "一時停止",
                         "key":  "paused",
                         "default":  false,
                         "description":  "手動停止状態を保存します。ロック・リモート接続による停止は別に維持します。",
                         "type":  "boolean"
                     },
                     {
                         "maximum":  2147483,
                         "title":  "壁紙の更新間隔（秒）",
                         "key":  "intervalSeconds",
                         "type":  "number",
                         "description":  "長めの間隔ほど画像の読み込みとCPU使用を減らせます。",
                         "default":  60,
                         "step":  1,
                         "minimum":  1
                     },
                     {
                         "title":  "モニターごとの画像設定",
                         "key":  "monitors",
                         "default":  "[]",
                         "description":  "左から右の画面順に設定します。例: [{\"Folders\":[\"C:/Wallpapers/A\",\"C:/Wallpapers/B\"],\"Mode\":\"Tile\",\"TileCount\":4}]。Foldersは複数指定可。未設定の画面は黒になります。",
                         "type":  "json"
                     },
                     {
                         "default":  10,
                         "maximum":  4096,
                         "minimum":  0,
                         "step":  1,
                         "type":  "number",
                         "key":  "tileMargin",
                         "title":  "タイル間の余白（px）"
                     },
                     {
                         "maximum":  1000,
                         "title":  "履歴件数（モニターごと）",
                         "key":  "historyLimit",
                         "type":  "number",
                         "description":  "0で履歴を残しません。履歴は実行中だけ保持し、画像は表示ページだけ読み込みます。",
                         "default":  30,
                         "step":  1,
                         "minimum":  0
                     },
                     {
                         "default":  320,
                         "maximum":  320,
                         "minimum":  1,
                         "step":  1,
                         "type":  "number",
                         "key":  "thumbnailWidth",
                         "title":  "履歴サムネイルの幅（px）"
                     },
                     {
                         "default":  240,
                         "maximum":  240,
                         "minimum":  1,
                         "step":  1,
                         "type":  "number",
                         "key":  "thumbnailHeight",
                         "title":  "履歴サムネイルの高さ（px）"
                     },
                     {
                         "default":  30,
                         "maximum":  160,
                         "minimum":  1,
                         "step":  1,
                         "type":  "number",
                         "key":  "maxFileNameLength",
                         "title":  "履歴ファイル名の表示文字数"
                     }
                 ]
}
